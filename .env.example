# Public deployment URL — enables canonical link, absolute Open Graph image and sitemap.xml
VITE_SITE_URL=

# 'true' allows search engines to index the site (default: noindex for privacy)
VITE_ALLOW_INDEXING=false

# Optional RSVP endpoint accepting a JSON POST (Formspree, Apps Script, serverless).
# Public URL only — never put secret keys in VITE_ variables.
VITE_RSVP_ENDPOINT=
